PORT=5000
NODE_ENV=development
POSTGRES_PASSWORD=example-pass
POSTGRES_USER=example-user
POSTGRES_DB=example-db
DATABASE_URL=postgresql://example-user:example-pass@db:5432/example-db
# Rate limiting (TD-028): at most RATE_LIMIT_MAX requests per client per window. Both must be positive integers.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of reverse proxies in front of the API. Keep 0 unless one sets X-Forwarded-For (TD-028).
TRUST_PROXY=0
