# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.

DATABASE_URL="postgresql://user:password@localhost:5433/mydb"

# Rate limiting (TD-028): at most RATE_LIMIT_MAX requests per client per window. Both must be positive integers.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of reverse proxies in front of the API. Keep 0 unless one sets X-Forwarded-For (TD-028).
TRUST_PROXY=0
